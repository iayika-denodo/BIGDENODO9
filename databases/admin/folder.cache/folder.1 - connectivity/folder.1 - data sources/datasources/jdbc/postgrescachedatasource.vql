# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE DATASOURCE JDBC postgrescachedatasource
    FOLDER = '/cache/1 - connectivity/1 - data sources'
    DRIVERCLASSNAME = 'org.postgresql.Driver'
    DATABASEURI = '${databases.admin.folder.cache.folder.1 - connectivity.folder.1 - data sources.datasources.jdbc.postgrescachedatasource.DATABASEURI}'
    USERNAME = '${databases.admin.folder.cache.folder.1 - connectivity.folder.1 - data sources.datasources.jdbc.postgrescachedatasource.USERNAME}'
    USERPASSWORD = '${databases.admin.folder.cache.folder.1 - connectivity.folder.1 - data sources.datasources.jdbc.postgrescachedatasource.USERPASSWORD}' ${databases.admin.folder.cache.folder.1 - connectivity.folder.1 - data sources.datasources.jdbc.postgrescachedatasource.USERPASSWORD.ENCRYPTED}
    CLASSPATH = 'postgresql-17'
    DATABASENAME = 'postgresql'
    DATABASEVERSION = '17'
    FETCHSIZE = 1000
    VALIDATIONQUERY = 'Select 1'
    INITIALSIZE = 4
    MAXIDLE = -1
    MINIDLE = 0
    MAXACTIVE = 20
    EXHAUSTEDACTION = 1
    TESTONBORROW = true
    TESTONRETURN = false
    TESTWHILEIDLE = false
    TIMEBETWEENEVICTION = -1
    NUMTESTPEREVICTION = 3
    MINEVICTABLETIME = 1800000
    POOLPREPAREDSTATEMENTS = false
    MAXOPENPREPAREDSTATEMENTS = -1
    PROPERTIES ('escapeSyntaxCallMode'='callIfNoReturn')
    KERBEROSPROPERTIES ('jaasLogin'='false', 'user'='<user>')
    DATA_LOAD_CONFIGURATION (
        BATCHINSERTSIZE = 200
    );

