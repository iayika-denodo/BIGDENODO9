# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE DATASOURCE LDAP dummy_ldap
    FOLDER = '/authentication/1 - connectivity/1 - data sources'
    URI='${databases.admin.folder.authentication.folder.1 - connectivity.folder.1 - data sources.datasources.ldap.dummy_ldap.URI}'
    USERNAME='${databases.admin.folder.authentication.folder.1 - connectivity.folder.1 - data sources.datasources.ldap.dummy_ldap.USERNAME}'
    USERPASSWORD='${databases.admin.folder.authentication.folder.1 - connectivity.folder.1 - data sources.datasources.ldap.dummy_ldap.USERPASSWORD}' ${databases.admin.folder.authentication.folder.1 - connectivity.folder.1 - data sources.datasources.ldap.dummy_ldap.USERPASSWORD.ENCRYPTED}
    USEPAGING=FALSE
    POOL_ENABLED = TRUE;

