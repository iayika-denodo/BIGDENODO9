# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE DATASOURCE LDAP ds_active_directory
    FOLDER = '/authentication/connectivity/data sources'
    URI='${databases.admin.folder.authentication.folder.connectivity.folder.data sources.datasources.ldap.ds_active_directory.URI}'
    USERNAME='${databases.admin.folder.authentication.folder.connectivity.folder.data sources.datasources.ldap.ds_active_directory.USERNAME}'
    USERPASSWORD='${databases.admin.folder.authentication.folder.connectivity.folder.data sources.datasources.ldap.ds_active_directory.USERPASSWORD}' ${databases.admin.folder.authentication.folder.connectivity.folder.data sources.datasources.ldap.ds_active_directory.USERPASSWORD.ENCRYPTED}
    USEPAGING=FALSE
    POOL_ENABLED = TRUE;

