# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE DATASOURCE JSON pokemon
    FOLDER = '/connectivity/data sources'
    ROUTE HTTP 'http.ApacheHttpClientConnection,120000' GET '${databases.http.folder.connectivity.folder.data sources.datasources.json.pokemon.ROUTE.HTTP.URL}'
    GENERATE_OUTPUT_ON_EMPTY_CONTENT
    AUTHENTICATION BASIC ( 
      USER '${databases.http.folder.connectivity.folder.data sources.datasources.json.pokemon.ROUTE.HTTP.USER}'
      PASSWORD '${databases.http.folder.connectivity.folder.data sources.datasources.json.pokemon.ROUTE.HTTP.PASSWORD}' ${databases.http.folder.connectivity.folder.data sources.datasources.json.pokemon.ROUTE.HTTP.PASSWORD.ENCRYPTED} )
    PROXY OFF;

