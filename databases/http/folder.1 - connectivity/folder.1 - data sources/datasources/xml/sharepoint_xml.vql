# REQUIRES-PROPERTIES-FILE - # Do not remove this comment!
CREATE OR REPLACE DATASOURCE XML sharepoint_xml
    FOLDER = '/1 - connectivity/1 - data sources'
    ROUTE HTTP 'http.ApacheHttpClientConnection,120000' GET '${databases.http.folder.1 - connectivity.folder.1 - data sources.datasources.xml.sharepoint_xml.ROUTE.HTTP.URL}'
    GENERATE_OUTPUT_ON_EMPTY_CONTENT
    AUTHENTICATION OAUTH20 ( 
      ACCESSTOKEN = '${databases.http.folder.1 - connectivity.folder.1 - data sources.datasources.xml.sharepoint_xml.ROUTE.HTTP.ACCESSTOKEN}' ${databases.http.folder.1 - connectivity.folder.1 - data sources.datasources.xml.sharepoint_xml.ROUTE.HTTP.ACCESSTOKEN.ENCRYPTED}
      REQUESTSIGNINGMETHOD = ${databases.http.folder.1 - connectivity.folder.1 - data sources.datasources.xml.sharepoint_xml.ROUTE.HTTP.REQUESTSIGNINGMETHOD}
      AUTHENTICATION_GRANT = ${databases.http.folder.1 - connectivity.folder.1 - data sources.datasources.xml.sharepoint_xml.ROUTE.AUTHENTICATION.GRANT}
      CLIENTIDENTIFIER = '${databases.http.folder.1 - connectivity.folder.1 - data sources.datasources.xml.sharepoint_xml.ROUTE.HTTP.CLIENTIDENTIFIER}'
      CLIENTSECRET = '${databases.http.folder.1 - connectivity.folder.1 - data sources.datasources.xml.sharepoint_xml.ROUTE.HTTP.CLIENTSECRET}' ${databases.http.folder.1 - connectivity.folder.1 - data sources.datasources.xml.sharepoint_xml.ROUTE.HTTP.CLIENTSECRET.ENCRYPTED}
    )
    PROXY OFF;

