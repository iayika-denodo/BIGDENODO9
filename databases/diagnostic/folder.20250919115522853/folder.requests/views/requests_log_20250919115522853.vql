CREATE OR REPLACE VIEW requests_log_20250919115522853 FOLDER = '/20250919115522853/requests' AS SELECT id, database_name, user_name, notification_type, session_id, start_time, case WHEN (end_time is not null ) THEN end_time ELSE NULL END AS end_time, case duration_as_text WHEN '-' THEN NULL ELSE cast('long', duration_as_text) END AS duration, case waiting_time_as_text WHEN '-' THEN NULL ELSE cast('long', waiting_time_as_text) END AS waiting_time, case num_rows_as_text WHEN '-' THEN NULL ELSE cast('long', num_rows_as_text) END AS num_rows, nullif(state, '-') AS state, case cache_as_text WHEN '-' THEN NULL ELSE cast('boolean', cache_as_text) END AS cache, substr(query FROM 1 FOR 32672) AS query, request_type, nullif(elements, '-') AS elements, nullif(user_agent, '-') AS user_agent, access_interface, nullif(client_ip, '-') AS client_ip, case transaction_id_as_text WHEN '-' THEN NULL ELSE cast('long', transaction_id_as_text) END AS transaction_id, nullif(webservice_name, '-') AS webservice_name, case cpu_time WHEN '-' THEN NULL ELSE cast('long', cpu_time) END AS cpu_time, case cpu_usage_avg WHEN '-' THEN NULL ELSE cast('float', cpu_usage_avg) END AS cpu_usage_avg, case cpu_usage_max WHEN '-' THEN NULL ELSE cast('float', cpu_usage_max) END AS cpu_usage_max, case cpu_usage_std_dev WHEN '-' THEN NULL ELSE cast('float', cpu_usage_std_dev) END AS cpu_usage_std_dev, case cpu_usage_max_time WHEN '-' THEN NULL ELSE to_timestamptz('yyyy-MM-dd''T''HH:mm:ss.SSS', cpu_usage_max_time) END AS cpu_usage_max_time FROM requests_interval_log_20250919115522853 CONTEXT ('I18N' = 'rfc_restful');

